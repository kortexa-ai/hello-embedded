{
  "name": "hello-embedded",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal portable Electrobun app. Same source, every target — desktop or bare-DRM kiosk on a Raspberry Pi.",
  "scripts": {
    "dev": "vite build && electrobun dev --watch",
    "start": "electrobun run --env=dev",
    "build": "./build.sh prod",
    "build:app": "vite build && electrobun build --env=stable",
    "hmr": "vite --port 5174",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run dev\""
  },
  "dependencies": {
    "@json-render/core": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "@json-render/shadcn": "^0.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electrobun": "2.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2"
  }
}
